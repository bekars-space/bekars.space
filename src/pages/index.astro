---
import logo from '../assets/bekars-space.svg';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<img src={logo.src} alt="Bekars Space" />
	</main>
</Layout>

<style>
	main {
		display: grid;
		place-items: center;
		min-height: 100vh;
		min-height: 100dvh;
	}

	img {
		display: block;
		width: min(24rem, 76vw, 76vh);
		width: min(24rem, 76vw, 76dvh);
		height: auto;
		aspect-ratio: 126.45475 / 20;
	}
</style>
